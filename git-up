#!/usr/bin/env bash
# git-up — pull develop (or master) across all git repos in cwd
# Usage: git up [--back] [--exclude=<pattern>[,<pattern>...]] [--clean]

set -euo pipefail

BIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LIB_DIR=""
for candidate in "$(dirname "$BIN_DIR")/lib/git-up" "$BIN_DIR/lib"; do
  if [[ -d "$candidate" ]]; then
    LIB_DIR="$candidate"
    break
  fi
done
if [[ -z "$LIB_DIR" ]]; then
  printf "Error: git-up lib directory not found\n" >&2
  exit 1
fi
for f in "$LIB_DIR"/*.sh; do
  source "$f"
done

BACK=false
CLEAN=false
EXCLUDE_PATTERNS=()
for arg in "$@"; do
  case "$arg" in
    --back) BACK=true ;;
    --clean) CLEAN=true ;;
    --exclude=*)
      IFS=',' read -ra EXCLUDE_PATTERNS <<< "${arg#--exclude=}" ;;
    --help|-h)
      printf "Usage: git up [--back] [--exclude=<pattern>[,<pattern>...]] [--clean]\n"
      printf "  Pulls develop (or master) in every git repo under cwd.\n"
      printf "  --back              Return to original branch after pulling.\n"
      printf "  --exclude=<patterns>  Comma-separated glob patterns of folders to skip.\n"
      printf "  --clean             Remove stash entries created by git-up, across all\n"
      printf "                      repos, and exit (does not run the pull flow).\n"
      exit 0 ;;
    *) printf "Unknown argument: %s\n" "$arg" >&2; exit 1 ;;
  esac
done

if $CLEAN; then
  _run_clean
  exit $?
fi

COUNT_OK=0
COUNT_SKIP=0
COUNT_ERR=0
TIMESTAMP=$(date '+%Y-%m-%d-%H:%M:%S')

_walk_repos _process_repo

printf "\n${BOLD}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}\n"
printf "  ${GREEN}%d updated${RESET}  ${DIM}%d skipped${RESET}  " "$COUNT_OK" "$COUNT_SKIP"
if [[ $COUNT_ERR -gt 0 ]]; then
  printf "${RED}%d errors${RESET}\n" "$COUNT_ERR"
else
  printf "${GREEN}0 errors${RESET}\n"
fi
printf "\n"
